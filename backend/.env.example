# ==============================================================================
# PLAUD Vertical Backend — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in the values.
# Without PLAUD_CLIENT_ID, the app runs in demo mode (no auth, mock data).

# --- Supabase (Required) ---
# Database for workflows, recordings, events, etc.
# Local: run `supabase start` in project root for default values below
# Cloud: get from Supabase dashboard → Settings → API
SUPABASE_URL=http://127.0.0.1:54331
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URI=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- PLAUD OAuth (Required for real auth, skip for demo mode) ---
# Register at https://developer.plaud.ai to get credentials
# Without these, the app runs in demo mode (no login required)
PLAUD_CLIENT_ID=
PLAUD_CLIENT_SECRET=
SESSION_SECRET=                              # Random string for signing session JWTs

# --- AI Services (Required for CRM update workflow) ---
GEMINI_API_KEY=                              # Google AI Studio → https://aistudio.google.com/apikey
ELEVENLABS_API_KEY=                          # ElevenLabs → https://elevenlabs.io/app/settings/api-keys

# --- Composio (Required for CRM/Calendar integrations) ---
# Get your API key from https://dashboard.composio.dev
COMPOSIO_API_KEY=

# Auth Config IDs — create these in Composio dashboard for each provider
COMPOSIO_GOOGLE_CALENDAR_AUTH_CONFIG_ID=
COMPOSIO_OUTLOOK_CALENDAR_AUTH_CONFIG_ID=
COMPOSIO_SALESFORCE_AUTH_CONFIG_ID=

# Webhook signature verification (recommended for production)
# Get this from Composio dashboard → Webhook settings
COMPOSIO_WEBHOOK_SECRET=

# --- ElevenLabs Webhooks (Optional) ---
# Enable async transcription via webhooks instead of polling
# Set these if you have a publicly accessible backend URL
ELEVENLABS_WEBHOOK_ID=
ELEVENLABS_WEBHOOK_SECRET=

# --- Production URLs (Optional, for deployed environments) ---
# BACKEND_URL=https://your-api.example.com   # Used for OAuth callback URL construction
# FRONTEND_URL=https://your-app.example.com  # Used for post-login redirect
