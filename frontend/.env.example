# ==============================================================================
# PLAUD Vertical Frontend — Environment Variables
# ==============================================================================
# Copy this file to .env.local and fill in the values.

# --- Backend API URL ---
# Local development: point to backend directly
# Production: leave empty to use Next.js API proxy (solves cross-domain cookie issues)
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Supabase (used by frontend auth helpers) ---
# Get from Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Production Backend Proxy (only needed in production) ---
# The Next.js API proxy forwards /api/* to this URL
# Only set this in production deployment (e.g., Vercel environment variables)
# BACKEND_API_URL=https://your-api.example.com
